<main class="container" style="max-width:560px">
  <h2 id="title">Recuperar contraseña</h2>

  <form id="askForm" class="form">
    <label>Email</label>
    <input type="email" name="email" required />
    <button type="submit">Enviar enlace</button>
  </form>

  <form id="resetForm" class="form" style="display:none">
    <input type="hidden" name="token" />
    <label>Nueva contraseña</label>
    <input type="password" name="password" required minlength="6" />
    <label>Repetir contraseña</label>
    <input type="password" name="password2" required minlength="6" />
    <button type="submit">Guardar</button>
  </form>

  <div id="msg" class="message" style="margin-top:12px"></div>
</main>

<script type="module">
  const msg = document.getElementById("msg");
  const askForm = document.getElementById("askForm");
  const resetForm = document.getElementById("resetForm");
  const params = new URLSearchParams(location.search);
  const token = params.get("token");

  if (token) {
    document.getElementById("title").textContent = "Restablecer contraseña";
    askForm.style.display = "none";
    resetForm.style.display = "block";
    resetForm.token.value = token;
  }

  askForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    msg.textContent = "";
    const email = askForm.email.value;
    const r = await fetch("/api/sessions/forgot-password", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email })
    });
    const data = await r.json().catch(() => ({}));
    msg.textContent = data.message || (r.ok ? "Revisá tu correo." : "Error");
  });

  resetForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    msg.textContent = "";
    const p1 = resetForm.password.value;
    const p2 = resetForm.password2.value;
    if (p1 !== p2) { msg.textContent = "Las contraseñas no coinciden"; return; }

    const r = await fetch("/api/sessions/reset-password", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token: resetForm.token.value, password: p1 })
    });
    const data = await r.json().catch(() => ({}));
    if (r.ok) {
      sessionStorage.setItem("flashToast", JSON.stringify({ text: "Contraseña actualizada. Iniciá sesión.", backgroundColor: "#28a745" }));
      window.location.href = "/login";
    } else {
      msg.textContent = data.error || data.message || "Error al actualizar la contraseña";
    }
  });
</script>
